DATABASE_URL=postgres://usuario:clave@localhost:5432/devwatch
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Motor de Monitoreo: tiempo máximo de espera de cada health check (ms)
MONITOR_TIMEOUT_MS=10000
# Motor de Monitoreo: cada cuántos segundos revisa qué servicios toca comprobar
MONITOR_TICK_SECONDS=5
# Motor de Monitoreo: máximo de health checks en paralelo
MONITOR_MAX_CONCURRENTES=20

# Incidentes: fallas seguidas (DOWN/TIMEOUT) para abrir un incidente. Valores más altos
# evitan falsos positivos por fallos de red aislados (riesgo R15 del Plan de Riesgos)
INCIDENTE_FALLOS_CONSECUTIVOS=2
